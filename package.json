{
  "name": "daftar-kelas-android",
  "version": "10.2.0",
  "private": true,
  "description": "Daftar Kelas Android and Windows app",
  "scripts": {
    "bundle:native": "esbuild www/native-files.js --bundle --platform=browser --format=iife --outfile=www/native-files.bundle.js",
    "android:sync": "cap sync android",
    "start:desktop": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "ir.daftarkelas.desktop",
    "productName": "Daftar Kelas",
    "asar": true,
    "files": ["www/**/*", "desktop/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Daftar-Kelas-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
